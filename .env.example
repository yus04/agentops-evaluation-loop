# =============================================================================
# .env.example — コピーして .env を作成してください (.env はコミットしない)
# =============================================================================

# --- LLM プロバイダ ----------------------------------------------------------
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxx

# --- Langfuse (観測基盤 / OpenTelemetry バックエンド) -------------------------
LANGFUSE_PUBLIC_KEY=pk-lf-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
LANGFUSE_SECRET_KEY=sk-lf-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# EU: https://cloud.langfuse.com / US: https://us.cloud.langfuse.com / JP: https://jp.cloud.langfuse.com
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_TRACING_ENVIRONMENT=production
LANGFUSE_ENABLED=true

# --- エージェント (本番コンテナ) ---------------------------------------------
AGENT_PROVIDER=openai
AGENT_TOOLS_MODE=mcp
AGENT_ENVIRONMENT=production
AGENT_SERVICE_NAME=order-support-agent
AGENT_MAX_TOOL_CALLS=4
AGENT_MAX_VALIDATION_RETRIES=2
# 設定すると /v1/support に X-API-Key ヘッダーが必須になる
AGENT_API_KEY=

# --- 評価 (DeepEval / LLM-as-a-Judge) ----------------------------------------
# エージェント用モデルとは必ず別モデルにすること
JUDGE_PROVIDER=openai
JUDGE_MODEL=gpt-4o
JUDGE_TEMPERATURE=0.0
JUDGE_MAX_CONCURRENCY=4

# --- GEPA reflection LM (改善候補を書く側) -----------------------------------
REFLECTION_PROVIDER=openai
REFLECTION_MODEL=gpt-4o
REFLECTION_TEMPERATURE=1.0

# --- DeepEval のテレメトリ送信を無効化 (任意) --------------------------------
DEEPEVAL_TELEMETRY_OPT_OUT=YES
